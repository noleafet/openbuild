# Openbuild Configurations
DEVOPS_DIR=../../devops

DEVOPS_CODE=02CODE
DEVOPS_TEST=04TEST
DEVOPS_MONITOR=08MONITOR

DEVOPS_POSTGRES_18=SQL_POSTGRES/postgres_18_alpine_compose.yml
DEVOPS_POSTGRES_15=SQL_POSTGRES/postgres_15_alpine_compose.yml
DEVOPS_SONAR_COMMUNITY=SONARQUBE/sonar_community_compose.yml
DEVOPS_PROMETHEUS_3_13_1=PROMETHEUS/prometheus_3.13.1_compose.yml
DEVOPS_GRAFANA_11_15_0=GRAFANA/grafana_11.5.0_compose.yml

DEVOPS_POSTGRES_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_CODE}_${DEVOPS_POSTGRES_18}
DEVOPS_POSTGRES_DIR_15=${DEVOPS_DIR}/${DEVOPS_CODE}_${DEVOPS_POSTGRES_15}
DEVOPS_SONAR_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_TEST}_${DEVOPS_SONAR_COMMUNITY}
DEVOPS_PROMETHEUS_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_MONITOR}_${DEVOPS_PROMETHEUS_3_13_1}
DEVOPS_GRAFANA_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_MONITOR}_${DEVOPS_GRAFANA_11_15_0}



# User Configurations

# Directories
VOLUME_DIR=../../proj/your_project

# Source Yml
DEVOPS_POSTGRES=${DEVOPS_POSTGRES_DIR_DEFAULT}
DEVOPS_SONAR=${DEVOPS_SONAR_DIR_DEFAULT}
DEVOPS_PROMETHEUS=${DEVOPS_PROMETHEUS_DIR_DEFAULT}
DEVOPS_GRAFANA=${DEVOPS_GRAFANA_DIR_DEFAULT}

# App DB
DB_USER=root
DB_PASSWORD=root
DB_NAME=your_db

# Sonar DB
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=StrongSecurePassword123!
SONAR_DB_NAME=sonar
# To avoid db port conflict
SONAR_DB_HOST_PORT=5442

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_HOST_PORT=3010