{
  "category_env_keys": {
    "01PLAN": "DEVOPS_PLAN",
    "02CODE": "DEVOPS_CODE",
    "03BUILD": "DEVOPS_BUILD",
    "04TEST": "DEVOPS_TEST",
    "05RELEASE": "DEVOPS_RELEASE",
    "06DEPLOY": "DEVOPS_DEPLOY",
    "07OPERATE": "DEVOPS_OPERATE",
    "08MONITOR": "DEVOPS_MONITOR"
  },
  "default_folder_aliases": {
    "SQL_POSTGRES": "POSTGRES",
    "SONARQUBE": "SONAR",
    "ELK_ELASTICSEARCH": "ELASTICSEARCH",
    "ELK_KIBANA": "KIBANA",
    "ELK_LOGSTASH": "LOGSTASH"
  },
  "openbuild_configurations": [
    "# Openbuild Configurations",
    "DEVOPS_DIR=../../devops",
    ""
  ],
  "user_configurations": [
    "# User Configurations",
    "",
    "# Directories",
    "VOLUME_DIR=../../proj/your_project",
    "",
    "# Source Yml",
    "DEVOPS_POSTGRES=${DEVOPS_POSTGRES_DIR_DEFAULT}",
    "DEVOPS_SONAR=${DEVOPS_SONAR_DIR_DEFAULT}",
    "DEVOPS_PROMETHEUS=${DEVOPS_PROMETHEUS_DIR_DEFAULT}",
    "DEVOPS_GRAFANA=${DEVOPS_GRAFANA_DIR_DEFAULT}",
    "",
    "# App DB",
    "DB_USER=root",
    "DB_PASSWORD=root",
    "DB_NAME=your_db",
    "",
    "# On windows permission issue, enable this workaround to stop postgres 18+ from running an chmod on the Windows mount root.",
    "# PGDATA=/mnt/postgres_win/data",
    "",
    "# Sonar DB",
    "SONAR_DB_USER=sonar",
    "SONAR_DB_PASSWORD=StrongSecurePassword123!",
    "SONAR_DB_NAME=sonar",
    "# To avoid db port conflict",
    "SONAR_DB_HOST_PORT=5442",
    "",
    "# Grafana",
    "GF_SECURITY_ADMIN_USER=admin",
    "GF_SECURITY_ADMIN_PASSWORD=admin",
    "GF_HOST_PORT=3010",
    "",
    "# Workspaces",
    "MAVEN_WORKSPACE=./workspace",
    "GRADLE_WORKSPACE=./workspace",
    "NODE_WORKSPACE=./workspace",
    "CYPRESS_WORKSPACE=./workspace",
    "",
    "# Splunk",
    "SPLUNK_PASSWORD=SplunkSecurePassword123",
    "",
    "# Datadog",
    "DD_API_KEY=your_datadog_api_key_here",
    "DD_SITE=datadoghq.com"
  ]
}
