# Openbuild Configurations
DEVOPS_DIR=../../devops

DEVOPS_PLAN=01PLAN
DEVOPS_CODE=02CODE
DEVOPS_PLAN=03BUILD
DEVOPS_TEST=04TEST
DEVOPS_RELEASE=05RELEASE
DEVOPS_DEPLOY=06DEPLOY
DEVOPS_OPERATE=07OPERATE
DEVOPS_MONITOR=08MONITOR

DEVOPS_POSTGRES_18=SQL_POSTGRES/postgres_18_alpine_compose.yml
DEVOPS_POSTGRES_15=SQL_POSTGRES/postgres_15_alpine_compose.yml
DEVOPS_SONAR_COMMUNITY=SONARQUBE/sonar_community_compose.yml
DEVOPS_PROMETHEUS_3_13_1=PROMETHEUS/prometheus_3.13.1_compose.yml
DEVOPS_GRAFANA_11_15_0=GRAFANA/grafana_11.5.0_compose.yml

DEVOPS_POSTGRES_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_CODE}_${DEVOPS_POSTGRES_18}
DEVOPS_POSTGRES_DIR_15=${DEVOPS_DIR}/${DEVOPS_CODE}_${DEVOPS_POSTGRES_15}
DEVOPS_SONAR_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_TEST}_${DEVOPS_SONAR_COMMUNITY}
DEVOPS_PROMETHEUS_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_MONITOR}_${DEVOPS_PROMETHEUS_3_13_1}
DEVOPS_GRAFANA_DIR_DEFAULT=${DEVOPS_DIR}/${DEVOPS_MONITOR}_${DEVOPS_GRAFANA_11_15_0}

# Other yamls are still undergoing testing
DEVOPS_=01PLAN_CONFLUENCE/confluence_server_8_8_jdk17_compose.yml
DEVOPS_=01PLAN_JIRA/jira_10_6_1_ubuntu_jdk17_compose.yml
DEVOPS_=02CODE_GIT/git_client_316123a_compose.yml
DEVOPS_=02CODE_GITLAB/gitlab_19_3_1_ce_0_compose.yml
DEVOPS_=02CODE_BITBUCKET/bitbucket_8_16_3_ubuntu_jdk17_compose.yml
DEVOPS_=02CODE_SQL_POSTGRES/postgres_db_18_6_alpine3_23_compose.yml
DEVOPS_=03BUILD_MAVEN/maven_alpine_compose.yml
DEVOPS_=03BUILD_GRADLE/gradle_9_7_1_jdk26_ubi10_compose.yml
DEVOPS_=03BUILD_NPM/node_npm_26_8_1_alpine3_24_compose.yml
DEVOPS_=04TEST_CYPRESS/cypress_16_0_0_compose.yml
DEVOPS_=04TEST_SONARQUBE/sonarqube_lts_community_compose.yml
DEVOPS_=04TEST_POSTMAN/postman_6_1_3_alpine_compose.yml
DEVOPS_=05RELEASE_JENKINS/jenkins_lts_compose.yml
DEVOPS_=05RELEASE_ARGOCD/argocd_v2_6_15_compose.yml
DEVOPS_=05RELEASE_GITLAB/gitlab_runner_alpine_compose.yml
DEVOPS_=06DEPLOY_KUBERNETES/kubectl_latest_compose.yml
DEVOPS_=06DEPLOY_OPENSHIFT/openshift_cli_v4_0_0_compose.yml
DEVOPS_=07OPERATE_ANSIBLE/ansible_latest_compose.yml
DEVOPS_=07OPERATE_TERRAFORM/terraform_1_16_1_compose.yml
DEVOPS_=08MONITOR_GRAFANA/grafana_13_2_1_slim_compose.yml
DEVOPS_=08MONITOR_PROMETHEUS/prometheus_v3_14_0_distroless_compose.yml
DEVOPS_=08MONITOR_ELK_ELASTICSEARCH/elasticsearch_8_12_0_compose.yml
DEVOPS_=08MONITOR_ELK_LOGSTASH/logstash_8_12_0_compose.yml
DEVOPS_=08MONITOR_ELK_KIBANA/kibana_8_12_0_compose.yml
DEVOPS_=08MONITOR_SPLUNK/splunk_580016365a30_rhel9_compose.yml
DEVOPS_=08MONITOR_DATADOG/datadog_7_83_0_fips_jmx_compose.yml


# User Configurations

# Directories
VOLUME_DIR=../../samples/openbook

# Source Yml
DEVOPS_POSTGRES=${DEVOPS_POSTGRES_DIR_DEFAULT}
DEVOPS_SONAR=${DEVOPS_SONAR_DIR_DEFAULT}
DEVOPS_PROMETHEUS=${DEVOPS_PROMETHEUS_DIR_DEFAULT}
DEVOPS_GRAFANA=${DEVOPS_GRAFANA_DIR_DEFAULT}

# App DB
DB_USER=leafnote
DB_PASSWORD=leafnote
DB_NAME=openbook

# On windows permission issue, enable this workaround to stop postgres 18+ from running an chmod on the Windows mount root.
PGDATA=/mnt/postgres_win/data

# Sonar DB
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=StrongSecurePassword123!
SONAR_DB_NAME=sonar
# To avoid db port conflict
SONAR_DB_HOST_PORT=5442

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_HOST_PORT=3010

# Workspaces
MAVEN_WORKSPACE=./workspace
GRADLE_WORKSPACE=./workspace
NODE_WORKSPACE=./workspace
CYPRESS_WORKSPACE=./workspace

# Splunk
SPLUNK_PASSWORD=SplunkSecurePassword123

# Datadog
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com



